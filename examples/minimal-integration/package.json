{
  "name": "@remote-acp/example-minimal-integration",
  "version": "0.1.0",
  "private": true,
  "description": "EXAMPLE: the smallest possible Remote ACP Bridge website integration, written as a read-top-to-bottom tutorial.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "dev": "pnpm --filter @remote-acp/example-minimal-integration... build && REMOTE_ACP_SERVICE_SECRET=${REMOTE_ACP_SERVICE_SECRET:-dev-only-minimal-integration-secret-0123456789} node dist/server.js",
    "relay": "cargo run --manifest-path ../../Cargo.toml -p remote-acp-relay -- --config relay.dev.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@remote-acp/browser-helper": "workspace:*",
    "@remote-acp/web-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
