{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Remote ACP Bridge",
  "version": "0.1.0",
  "identifier": "com.remoteacp.bridge",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Remote ACP Bridge",
        "width": 1080,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "maxWidth": 1600,
        "maxHeight": 1200,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 22 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Connect your local AI agent to trusted websites",
    "longDescription": "Remote ACP Bridge lets you use an AI coding agent on your own computer from a website you trust, while you keep control of sign-in, files, permissions and execution.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": { "minimumSystemVersion": "11.0" }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["remoteacp"] }
    }
  }
}
